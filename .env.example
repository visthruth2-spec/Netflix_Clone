# MERN Stack Configuration
# MONGODB_URI: MongoDB connection string (e.g. MongoDB Atlas cluster or local mongodb://localhost:27017/netflix_clone)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/netflix_clone?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="your_super_secret_jwt_key_here"

# PORT: Server port (defaults to 3000 for AI Studio, 5000 for standalone backend)
PORT=3000

